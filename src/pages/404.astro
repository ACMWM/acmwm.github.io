---
const target = "https://acm.cs.wm.edu";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script define:vars={{ target }}>
      window.location.replace(target + window.location.pathname + window.location.search + window.location.hash);
    </script>
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>acm.cs.wm.edu</a>.</p>
  </body>
</html>